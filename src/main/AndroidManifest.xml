<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
<uses-feature android:name="android.hardware.usb.host" android:required="false"/>
<uses-feature android:glEsVersion="0x00030000" android:required="true"/>
<application android:label="InfiniPlay" android:theme="@style/PlayTheme" android:icon="@mipmap/ic_launcher" android:allowBackup="false">
<activity android:name=".PlayActivity" android:launchMode="singleTop" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout">
<intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
<intent-filter>
<action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/>
<data android:scheme="content"/><data android:scheme="file"/>
<data android:mimeType="*/*"/>
</intent-filter>
<intent-filter><action android:name="android.intent.action.SEND"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="*/*"/></intent-filter>
</activity>
<activity android:name=".SessionActivity" android:exported="false" android:process=":emulator" android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout"/>
</application></manifest>